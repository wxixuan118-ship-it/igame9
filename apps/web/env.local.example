# Copy to apps/web/env.local and replace all example values.
DATABASE_URL=postgres://postgres:password@localhost:5433/starter
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3011
# Optional (set VITE_GOOGLE_LOGIN=1 to show the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=localhost
VITE_TURNSTILE_SITE_KEY=
# Optional: password-reset email
RESEND_API_KEY=
RESEND_FROM=Starter <hello@example.com>
ADMIN_EMAILS=you@example.com
ADMIN_BETTER_AUTH_URL=http://localhost:3012
ADMIN_BETTER_AUTH_SECRET=replace-with-another-random-secret-at-least-32-characters
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# USD price of a featured (paid) listing
FEATURED_LISTING_PRICE_USD=29
# Optional: admin blog image upload
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=https://media.example.com
VITE_SITE_NAME=igame9
VITE_GOOGLE_LOGIN=
VITE_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
